# Oracle Database connection
# ORACLE_PWD is required: docker compose refuses to start without it and the app
# exits its connection path instead of falling back to a shipped default.
# Use a strong, unique password.
ORACLE_PWD=
ORACLE_USER=system
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Published port bindings and ports
# Binds default to 127.0.0.1 so the API and the database listener are not exposed
# on every host interface. Set to 0.0.0.0 only deliberately.
APP_BIND=127.0.0.1
DEV_BIND=127.0.0.1
ORACLE_BIND=127.0.0.1
APP_PORT=8000
DEV_PORT=8001

# Oracle Enterprise Manager (optional)
ORACLE_EM_PORT=5500

# Embedding model (for vector search demo)
# Options: "mock" (default, no external deps), "ollama" (requires running Ollama)
EMBEDDING_PROVIDER=mock
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# RAG (Retrieval-Augmented Generation)
# Options: "mock" (returns retrieved context), "ollama" (real LLM generation)
RAG_PROVIDER=mock
OLLAMA_CHAT_MODEL=qwen3:8b
RAG_TOP_K=5
RAG_USE_CACHE=true

# Semantic cache
# Cosine distance threshold: lower = stricter matching (0.15 is a good default)
CACHE_SIMILARITY_THRESHOLD=0.15
